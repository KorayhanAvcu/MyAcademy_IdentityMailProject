
@{
    ViewData["Title"] = "Şifre Sıfırlama";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Identity Mail - Şifre Sıfırlama</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body {
            background: linear-gradient(135deg, #0d6efd 0%, #4f8dfd 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: "Segoe UI", sans-serif;
        }

        .confirmation-card {
            width: 100%;
            max-width: 430px;
            border: none;
            border-radius: 16px;
            box-shadow: 0 15px 40px rgba(0,0,0,.15);
        }

        .logo {
            width: 80px;
            height: 80px;
            background: #0d6efd;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 36px;
            margin: auto;
        }

        .card-title {
            font-weight: 700;
        }

        .text-small {
            font-size: .9rem;
        }

        .btn-login {
            height: 48px;
            border-radius: 10px;
            font-weight: 600;
        }

        .info-icon {
            font-size: 50px;
            color: #0d6efd;
        }

    </style>

</head>

<body>

    <div class="card confirmation-card">

        <div class="card-body p-5">

            <div class="text-center">

                <div class="logo mb-4">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>

                <h3 class="card-title mb-3">
                    E-Postanızı Kontrol Edin
                </h3>

                <p class="text-muted text-small mb-4">
                    Eğer girdiğiniz e-posta adresi sistemimizde
                    kayıtlıysa, şifre sıfırlama bağlantısı
                    e-posta adresinize gönderilmiştir.
                </p>

                <div class="alert alert-info text-start">

                    <i class="bi bi-info-circle me-2"></i>

                    E-posta birkaç dakika içinde gelmezse
                    <strong>Spam / Gereksiz</strong> klasörünüzü
                    kontrol etmeyi unutmayın.

                </div>

                <a asp-controller="Auth"
                   asp-action="Login"
                   class="btn btn-primary w-100 btn-login mt-3">

                    <i class="bi bi-arrow-left me-2"></i>

                    Giriş Sayfasına Dön

                </a>

            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>

