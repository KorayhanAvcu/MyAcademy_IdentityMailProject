@model List<UserMessage>

@{
    ViewData["Title"] = "Gelen Kutusu";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Gelen Kutusu</h2>

        <p class="text-muted mb-0">
            Hoş geldin <strong>@ViewBag.fullName</strong>
        </p>
    </div>

    <div class="d-flex align-items-center gap-3">

        <form method="get" asp-controller="Message" asp-action="Index">
            <select name="isRead"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value=""
                        selected="@(string.IsNullOrEmpty(Context.Request.Query["isRead"]))">
                    Tümü
                </option>

                <option value="1"
                        selected="@(Context.Request.Query["isRead"] == "1")">
                    Okundu
                </option>

                <option value="0"
                        selected="@(Context.Request.Query["isRead"] == "0")">
                    Okunmadı
                </option>

            </select>
        </form>


        <a href="/Message/SendMail"
           class="btn btn-primary d-none d-md-inline-flex align-items-center">

            <i class="bi bi-pencil-square me-2"></i>
            Yeni Mail Gönder

        </a>


        <a href="/Message/SendMail"
           class="btn btn-primary d-md-none rounded-circle p-0 d-flex align-items-center justify-content-center"
           style="width:44px;height:44px;">

            <i class="bi bi-pencil-square"></i>

        </a>

    </div>

</div>


<div class="mail-list-card p-3">

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table mail-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Gönderen Ad Soyad</th>

                        <th class="d-none d-lg-table-cell">
                            Email
                        </th>

                        <th>
                            Konu
                        </th>

                        <th class="d-none d-md-table-cell">
                            Tarih
                        </th>

                        <th class="text-end">
                            İşlemler
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsRead ? "" : "unread-row")">

                            <td>

                                <span onclick="isImportant(@item.Id)"
                                      class="material-symbols-outlined mail-star @(item.IsImportant ? "active" : "")">
                                    star
                                </span>

                                @item.Sender.FirstName @item.Sender.LastName

                            </td>


                            <td class="text-muted d-none d-lg-table-cell">
                                @item.Sender.Email
                            </td>


                            <td class="text-truncate"
                                style="max-width:260px;">
                                @item.Subject
                            </td>


                            <td class="text-muted d-none d-md-table-cell">
                                @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                            </td>


                            <td class="text-end">

                                <a href="/Message/MailDetail/@item.Id"
                                   class="btn btn-icon"
                                   title="Maili Görüntüle">

                                    <i class="bi bi-envelope-open"></i>

                                </a>


                                <button onclick="deleteMessage(@item.Id)"
                                        class="btn btn-icon text-danger border-0 bg-transparent">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-envelope fs-1 text-secondary"></i>

            <h4 class="mt-3">
                Gelen Kutunuz Boş
            </h4>

            <p class="text-muted">
                Henüz size gönderilmiş mesaj bulunmuyor.
            </p>

        </div>
    }

</div>



<script>

    function isImportant(id) {
        window.location.href = `/Message/isImportant/${id}`;
    }
    function deleteMessage(id) {
         console.log(id);
        Swal.fire({
            title: "Çöp kutusuna taşınsın mı?",
            text: "Mesaj çöp kutusuna taşınacak.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Taşı",
            cancelButtonText: "İptal"
        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href = "/Message/MoveToTrash/" + id;

            }

        });

    }
</script>