@using IdentityMail.Web.DTOs.UserMessageDtos
@model CreateMessageReportDto

@{
    ViewData["Title"] = "Mesajı Şikayet Et";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">Mesajı Şikayet Et</h2>

        <p class="text-muted">
            Bu mesajı neden şikayet ettiğinizi belirtin.
        </p>
    </div>


    <div class="mail-list-card p-4">

        <form asp-controller="Message"
              asp-action="ReportMessage"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="MessageId" />


            <div class="mb-3">

                <label asp-for="Reason"
                       class="form-label fw-semibold">
                    Şikayet Nedeni
                </label>

                <select asp-for="Reason"
                        class="form-select">

                    <option value="">
                        Şikayet nedeni seçiniz
                    </option>

                    <option value="Spam">
                        Spam / Gereksiz mesaj
                    </option>

                    <option value="Hakaret">
                        Hakaret / Küfür
                    </option>

                    <option value="Tehdit">
                        Tehdit
                    </option>

                    <option value="Taciz">
                        Taciz / Rahatsız edici içerik
                    </option>

                    <option value="Uygunsuz İçerik">
                        Uygunsuz içerik
                    </option>

                    <option value="Dolandırıcılık">
                        Dolandırıcılık / Şüpheli içerik
                    </option>

                    <option value="Diğer">
                        Diğer
                    </option>

                </select>

                <span asp-validation-for="Reason"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-4">

                <label asp-for="Description"
                       class="form-label fw-semibold">
                    Açıklama
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Şikayetiniz hakkında detay verebilirsiniz..."></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>


            <div class="d-flex justify-content-end gap-2">

                <a asp-controller="Message"
                   asp-action="MailDetail"
                   asp-route-id="@Model.MessageId"
                   class="btn btn-secondary">
                    İptal
                </a>

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-flag me-2"></i>

                    Şikayet Et

                </button>

            </div>

        </form>

    </div>

</div>