@model List<UserMessage>
@{
    ViewData["Title"] = "Önemli Mesajlar";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Önemli Mesajlar</h2>
    </div>

    <a href="/Message/SendMail"
       class="btn btn-primary d-md-none rounded-circle p-0 d-flex align-items-center justify-content-center"
       style="width:44px;height:44px;">
        <i class="bi bi-pencil-square"></i>
    </a>
</div>

<div class="mail-list-card p-3">

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table mail-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Gönderen Ad Soyad</th>
                        <th class="d-none d-lg-table-cell">Email</th>
                        <th>Konu</th>
                        <th class="d-none d-md-table-cell">Tarih</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Sender.FirstName @item.Sender.LastName</td>
                            <td class="text-muted d-none d-lg-table-cell">@item.Sender.Email</td>
                            <td class="text-truncate" style="max-width:260px;">@item.Subject</td>
                            <td class="text-muted d-none d-md-table-cell">@item.SendDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <a href="/Message/MailDetail/@item.Id" class="btn btn-icon" title="Maili Görüntüle">
                                    <i class="bi bi-envelope-open"></i>
                                </a>
                                <a href="#" class="btn btn-icon text-danger" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-envelope fs-1 text-secondary"></i>
            <h4 class="mt-3">Gelen Kutunuz Boş</h4>
            <p class="text-muted">Henüz size gönderilmiş mesaj bulunmuyor.</p>
        </div>
    }

</div>

