@using IdentityMail.Web.DTOs.AdminDtos
@model List<UserListDto>
@{
    ViewData["Title"] = "UsersList";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Kullanıcılar</h2>
    </div>
   
</div>

<div class="mail-list-card p-3">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table mail-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Kullanıcı Adı Soyadı</th>
                        <th class="d-none d-lg-table-cell">Email</th>
                        <th>Rolü</th>
                        <th>Email Onay Durumu</th>
                        <th>Kullanıcı Durumu</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                               @item.FullName
                            </td>
                            <td class="text-muted d-none d-lg-table-cell">
                                @item.Email
                            </td>
                            <td>
                                @foreach (var role in item.Roles)
                                {
                                    <span class="badge bg-primary">
                                        @role
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.EmailConfirmed)
                                {
                                    <span class="badge bg-success">
                                        Onaylı
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Onaysız
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Pasif
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <a href="/Admin/UserEdit/@item.Id" class="btn btn-icon" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-file-earmark-text fs-1 text-secondary"></i>
            <h4 class="mt-3">Kullanıcı Listesi Boş</h4>
            
        </div>
    }
</div>



