@using IdentityMail.Web.DTOs.AdminDtos
@using IdentityMail.Web.Enums

@model List<MessageReportDto>

@{
    ViewData["Title"] = "Mesaj Şikayetleri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Mesaj Şikayetleri
        </h2>

        <p class="text-muted mb-0">
            Kullanıcılar tarafından bildirilen mesajlar
        </p>
    </div>

</div>


<div class="mail-list-card p-3">

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Konu</th>
                        <th>Şikayet Eden</th>
                        <th>Gönderen</th>
                        <th>Neden</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var report in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @report.Subject
                                </strong>
                            </td>

                            <td>
                                <div>
                                    @report.ReporterName
                                </div>

                                <small class="text-muted">
                                    @report.ReporterEmail
                                </small>
                            </td>

                            <td>
                                @report.SenderName
                            </td>

                            <td>
                                @report.Reason
                            </td>

                            <td>

                                @switch (report.Status)
                                {
                                    case ReportStatus.Pending:
                                        <span class="badge bg-warning text-dark">
                                            Bekliyor
                                        </span>
                                        break;

                                    case ReportStatus.Reviewing:
                                        <span class="badge bg-info">
                                            İnceleniyor
                                        </span>
                                        break;

                                    case ReportStatus.Resolved:
                                        <span class="badge bg-success">
                                            Çözüldü
                                        </span>
                                        break;

                                    case ReportStatus.Rejected:
                                        <span class="badge bg-danger">
                                            Reddedildi
                                        </span>
                                        break;
                                }

                            </td>

                            <td>
                                @report.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td class="text-end">

                                <a asp-action="MessageReportDetail"
                                   asp-route-id="@report.Id"
                                   class="btn btn-sm btn-primary">

                                    <i class="bi bi-eye me-1"></i>

                                    İncele

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-shield-check fs-1 text-success"></i>

            <h4 class="mt-3">
                Şikayet bulunmuyor
            </h4>

            <p class="text-muted">
                Henüz kullanıcılar tarafından bildirilen bir mesaj yok.
            </p>

        </div>
    }

</div>