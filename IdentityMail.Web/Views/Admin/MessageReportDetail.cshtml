@using IdentityMail.Web.DTOs.AdminDtos
@using IdentityMail.Web.Enums

@model MessageReportDetailDto

@{
    ViewData["Title"] = "Şikayet Detayı";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Şikayet Detayı
        </h2>

        <p class="text-muted mb-0">
            Bildirilen mesajı inceleyin ve şikayet hakkında işlem yapın.
        </p>
    </div>

    <a asp-action="MessageReports"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-2"></i>

        Şikayetlere Dön

    </a>

</div>


<div class="row g-4">

    <!-- ===================================================== -->
    <!-- SOL TARAF -->
    <!-- ===================================================== -->

    <div class="col-lg-4">

        <!-- ================================================= -->
        <!-- ŞİKAYET BİLGİLERİ -->
        <!-- ================================================= -->

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <h5 class="fw-bold mb-4">
                    <i class="bi bi-flag me-2"></i>
                    Şikayet Bilgileri
                </h5>


                <!-- ŞİKAYET EDEN -->

                <div class="mb-4">

                    <small class="text-muted d-block mb-1">
                        Şikayet Eden
                    </small>

                    <div class="fw-semibold">
                        @Model.ReporterName
                    </div>

                    <div class="text-muted small">
                        @Model.ReporterEmail
                    </div>

                </div>


                <!-- GÖNDEREN -->

                <div class="mb-4">

                    <small class="text-muted d-block mb-1">
                        Mesaj Gönderen
                    </small>

                    <div class="fw-semibold">
                        @Model.SenderName
                    </div>

                    <div class="text-muted small">
                        @Model.SenderEmail
                    </div>

                </div>


                <!-- ŞİKAYET NEDENİ -->

                <div class="mb-4">

                    <small class="text-muted d-block mb-1">
                        Şikayet Nedeni
                    </small>

                    <div class="fw-semibold">
                        @Model.Reason
                    </div>

                </div>


                <!-- TARİH -->

                <div class="mb-4">

                    <small class="text-muted d-block mb-1">
                        Şikayet Tarihi
                    </small>

                    <div>
                        @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                    </div>

                </div>


                <!-- DURUM -->

                <div>

                    <small class="text-muted d-block mb-2">
                        Mevcut Durum
                    </small>

                    @switch (Model.Status)
                    {
                        case ReportStatus.Pending:

                            <span class="badge bg-warning text-dark px-3 py-2">

                                <i class="bi bi-clock me-1"></i>

                                Bekliyor

                            </span>

                            break;


                        case ReportStatus.Reviewing:

                            <span class="badge bg-info px-3 py-2">

                                <i class="bi bi-search me-1"></i>

                                İnceleniyor

                            </span>

                            break;


                        case ReportStatus.Resolved:

                            <span class="badge bg-success px-3 py-2">

                                <i class="bi bi-check-circle me-1"></i>

                                Çözüldü

                            </span>

                            break;


                        case ReportStatus.Rejected:

                            <span class="badge bg-danger px-3 py-2">

                                <i class="bi bi-x-circle me-1"></i>

                                Reddedildi

                            </span>

                            break;
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- ŞİKAYETİ DEĞERLENDİR -->
        <!-- ================================================= -->

        <div class="card shadow-sm border-0 mt-4">

            <div class="card-body p-4">

                <!-- BAŞLIK -->

                <div class="mb-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-primary bg-opacity-10 rounded p-2 me-3">

                            <i class="bi bi-clipboard-check text-primary fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Şikayeti Değerlendir
                            </h5>

                            <p class="text-muted small mb-0">
                                Şikayeti inceleyerek uygun durumu belirleyin.
                            </p>

                        </div>

                    </div>

                </div>


                <form asp-action="UpdateMessageReport"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />


                    <!-- ================================================= -->
                    <!-- DURUM -->
                    <!-- ================================================= -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-activity me-1"></i>

                            Şikayet Durumu

                        </label>

                        <select name="status"
                                class="form-select form-select-lg">

                            <option value="1"
                                    selected="@(Model.Status == ReportStatus.Pending)">

                                Bekliyor

                            </option>

                            <option value="2"
                                    selected="@(Model.Status == ReportStatus.Reviewing)">

                                İnceleniyor

                            </option>

                            <option value="3"
                                    selected="@(Model.Status == ReportStatus.Resolved)">

                                Çözüldü

                            </option>

                            <option value="4"
                                    selected="@(Model.Status == ReportStatus.Rejected)">

                                Reddedildi

                            </option>

                        </select>

                        <div class="form-text mt-2">

                            <strong>Bekliyor:</strong>
                            Şikayet henüz incelenmedi.

                            <br />

                            <strong>İnceleniyor:</strong>
                            Yönetici tarafından inceleniyor.

                            <br />

                            <strong>Çözüldü:</strong>
                            Şikayet haklı bulundu ve işlem tamamlandı.

                            <br />

                            <strong>Reddedildi:</strong>
                            Şikayet uygun bulunmadı.

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ADMIN NOTU -->
                    <!-- ================================================= -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-pencil-square me-1"></i>

                            Yönetici Notu

                        </label>

                        <textarea name="adminNote"
                                  class="form-control"
                                  rows="7"
                                  maxlength="2000"
                                  placeholder="Şikayet ile ilgili inceleme sonucunu, alınan kararı veya gerekli açıklamayı buraya yazın...">@Model.AdminNote</textarea>

                        <div class="form-text">

                            Bu alan yöneticinin şikayet ile ilgili değerlendirmesini
                            ve aldığı kararı kaydetmek için kullanılır.

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ŞİKAYET BİLGİLERİ -->
                    <!-- ================================================= -->

                    <div class="border rounded-3 p-3 mb-4 bg-light">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="text-muted">
                                Şikayet ID
                            </span>

                            <strong>
                                #@Model.Id
                            </strong>

                        </div>


                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="text-muted">
                                Şikayet Tarihi
                            </span>

                            <span class="fw-semibold">

                                @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")

                            </span>

                        </div>


                        @if (Model.ReviewedDate.HasValue)
                        {
                            <div class="d-flex justify-content-between align-items-center">

                                <span class="text-muted">
                                    Son İnceleme
                                </span>

                                <span class="fw-semibold">

                                    @Model.ReviewedDate.Value.ToString("dd.MM.yyyy HH:mm")

                                </span>

                            </div>
                        }

                    </div>


                    <!-- ================================================= -->
                    <!-- KAYDET -->
                    <!-- ================================================= -->

                    <button type="submit"
                            class="btn btn-primary btn-lg w-100">

                        <i class="bi bi-check-lg me-2"></i>

                        Değerlendirmeyi Kaydet

                    </button>

                </form>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SAĞ TARAF -->
    <!-- ===================================================== -->

    <div class="col-lg-8">

        <!-- ================================================= -->
        <!-- MESAJ -->
        <!-- ================================================= -->

        <div class="card shadow-sm border-0">

            <div class="card-body p-3">

                <!-- KONU -->
                <div class="mb-3">

                    <small class="text-muted d-block mb-1">
                        Mesaj Konusu
                    </small>

                    <h5 class="fw-bold mb-0">
                        @Model.Subject
                    </h5>

                </div>


                <!-- ŞİKAYET AÇIKLAMASI -->
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="alert alert-warning border-0 py-2 px-3 mb-3">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle me-2 mt-1"></i>

                            <div>

                                <strong>
                                    Şikayet Açıklaması
                                </strong>

                                <div class="mt-1"
                                     style="white-space: pre-wrap;">
                                    @Model.Description
                                </div>

                            </div>

                        </div>

                    </div>
                }


                <hr class="my-3" />


                <!-- MESAJ İÇERİĞİ -->

                <div>

                    <small class="text-muted d-block mb-2">
                        Mesaj İçeriği
                    </small>

                    <div class="border rounded-3 p-3 bg-light"
                         style="white-space: pre-wrap; min-height: 150px;">
                        @Model.Body
                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- İNCELEME SONUCU -->
        <!-- ================================================= -->
        @if (Model.Status == ReportStatus.Resolved ||
                Model.Status == ReportStatus.Rejected)
        {
            <div class="card shadow-sm border-0 mt-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">

                        @if (Model.Status == ReportStatus.Resolved)
                        {
                            <i class="bi bi-check-circle text-success me-2"></i>

                            <span>
                                İnceleme Sonucu
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-x-circle text-danger me-2"></i>

                            <span>
                                İnceleme Sonucu
                            </span>
                        }

                    </h5>


                    @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                    {
                        <div class="border rounded-3 p-3 bg-light">

                            <div class="text-muted small mb-2">

                                Yönetici Notu

                            </div>

                            <div style="white-space: pre-wrap;">

                                @Model.AdminNote

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="text-muted">

                            Bu şikayet için yönetici notu girilmemiş.

                        </div>
                    }


                    @if (Model.ReviewedDate.HasValue)
                    {
                        <div class="text-muted small mt-3">

                            <i class="bi bi-clock me-1"></i>

                            İnceleme tarihi:

                            @Model.ReviewedDate.Value.ToString("dd.MM.yyyy HH:mm")

                        </div>
                    }

                </div>

            </div>
        }

    </div>

</div>