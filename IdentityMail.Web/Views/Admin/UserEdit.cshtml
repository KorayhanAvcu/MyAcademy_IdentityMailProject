@model IdentityMail.Web.DTOs.AdminDtos.UserEditDto

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="dashboard-card p-4">

        <h4 class="mb-4">
            Kullanıcı Düzenle
        </h4>

        <form asp-action="EditUser" method="post">

            <input type="hidden" asp-for="Id" />

            <!-- AD -->

            <div class="mb-3">

                <label asp-for="FirstName"
                       class="form-label">
                    Ad
                </label>

                <input asp-for="FirstName"
                       class="form-control" />

            </div>


            <!-- SOYAD -->

            <div class="mb-3">

                <label asp-for="LastName"
                       class="form-label">
                    Soyad
                </label>

                <input asp-for="LastName"
                       class="form-control" />

            </div>


            <!-- EMAIL -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control" />

            </div>


            <!-- AKTİF / PASİF -->

            <div class="mb-3">

                <label class="form-label">
                    Kullanıcı Durumu
                </label>

                <select asp-for="IsActive"
                        class="form-select">

                    <option value="true">
                        Aktif
                    </option>

                    <option value="false">
                        Pasif
                    </option>

                </select>

            </div>


            <!-- EMAIL ONAY -->

            <div class="mb-3">

                <label class="form-label">
                    Email Durumu
                </label>

                <select asp-for="EmailConfirmed"
                        class="form-select">

                    <option value="true">
                        Onaylı
                    </option>

                    <option value="false">
                        Onaysız
                    </option>

                </select>

            </div>


            <!-- ROL -->

            <div class="mb-4">

                <label asp-for="Role"
                       class="form-label">
                    Rol
                </label>

                <select asp-for="Role"
                        class="form-select">

                    <option value="User">
                        Kullanıcı
                    </option>

                    <option value="Admin">
                        Admin
                    </option>

                </select>

            </div>


            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    Kaydet

                </button>

                <a asp-action="Users"
                   class="btn btn-secondary">

                    İptal

                </a>

            </div>

        </form>

    </div>

</div>