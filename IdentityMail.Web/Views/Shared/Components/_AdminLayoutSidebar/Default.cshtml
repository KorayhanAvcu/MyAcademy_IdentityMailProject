@model SidebarViewModel

<aside class="mail-sidebar d-none d-md-flex">

    <!-- ===================================== -->
    <!-- LOGO -->
    <!-- ===================================== -->
    <div class="mail-sidebar-header">
        <div class="d-flex align-items-center">
            <div class="logo-circle me-3">
                @if (Model.IsAdmin)
                {
                    <i class="bi bi-shield-lock-fill"></i>
                }
                else
                {
                    <i class="bi bi-envelope-fill"></i>
                }
            </div>
            <div>
                <h4 class="mb-0">Identity Mail</h4>
                <small class="text-muted">
                    @(Model.IsAdmin ? "Yönetim Paneli" : "Mail Yönetim Sistemi")
                </small>
            </div>
        </div>
    </div>

    <!-- ===================================== -->
    <!-- USER SIDEBAR -->
    <!-- ===================================== -->
    @if (!Model.IsAdmin)
    {
        <!-- E-Posta Oluştur -->
        <div class="px-3 mt-2 mb-2">
            <a asp-controller="Message" asp-action="SendMail" class="btn btn-primary w-100 py-2">
                <i class="bi bi-pencil-square me-2"></i>
                E-Posta Oluştur
            </a>
        </div>

        <!-- User Menü -->
        <nav class="list-group list-group-flush">

            <a asp-controller="Message" asp-action="Index"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <span>
                    <i class="bi bi-inbox-fill me-3"></i>
                    Gelen Kutusu
                </span>

                @if (Model.UnreadCount > 0)
                {
                    <span class="badge bg-primary rounded-pill">@Model.UnreadCount</span>
                }
            </a>

            <a asp-controller="Message" asp-action="SentMail"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "SentMail" ? "active" : "")">
                <i class="bi bi-send-fill me-3"></i>
                Gönderilenler
            </a>

            <a asp-controller="Message" asp-action="Drafts"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Drafts" ? "active" : "")">
                <i class="bi bi-file-earmark-text-fill me-3"></i>
                Taslaklar
            </a>

            <a asp-controller="Message" asp-action="Important"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Important" ? "active" : "")">
                <i class="bi bi-star-fill me-3"></i>
                Önemli
            </a>

            <a asp-controller="Message" asp-action="Trash"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Trash" ? "active" : "")">
                <i class="bi bi-trash-fill me-3"></i>
                Çöp Kutusu
            </a>

            <a asp-controller="Category" asp-action="Index"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                <i class="bi bi-tags-fill me-3"></i>
                Kategoriler
            </a>

        </nav>
    }

    <!-- ===================================== -->
    <!-- ADMIN SIDEBAR -->
    <!-- ===================================== -->
    @if (Model.IsAdmin)
    {
        <nav class="list-group list-group-flush mt-2">

            <a asp-controller="Admin" asp-action="Dashboard"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2 me-3"></i>
                Genel Bakış
            </a>

            <a asp-controller="User" asp-action="Index"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                <i class="bi bi-people-fill me-3"></i>
                Kullanıcılar
            </a>

            <a asp-controller="Admin" asp-action="MessageStatistics"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "MessageStatistics" ? "active" : "")">
                <i class="bi bi-bar-chart-fill me-3"></i>
                Mesaj İstatistikleri
            </a>

            <a asp-controller="Admin" asp-action="Complaints"
               class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Complaints" ? "active" : "")">
                <i class="bi bi-flag-fill me-3"></i>
                Şikayetler
            </a>

        </nav>
    }

    <!-- ===================================== -->
    <!-- KULLANICI BİLGİLERİ -->
    <!-- ===================================== -->
    <div class="sidebar-user mt-auto p-3 border-top">
        <div class="d-flex align-items-center">

            @if (!string.IsNullOrWhiteSpace(Model.User.ProfileImageUrl))
            {
                <img src="@Model.User.ProfileImageUrl" alt="Profil Fotoğrafı" class="user-avatar-img" />
            }
            else
            {
                <div class="user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
            }

            <div class="ms-3">
                <div class="fw-semibold" style="font-size:14px;">
                    @Model.User.FirstName @Model.User.LastName
                </div>
                <small class="text-muted">
                    @(Model.IsAdmin ? "Admin" : "Kullanıcı")
                </small>
            </div>

        </div>

        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger w-100 mt-3">
            <i class="bi bi-box-arrow-right me-2"></i>
            Çıkış Yap
        </a>
    </div>

</aside>

<!-- ===================================== -->
<!-- MOBİL ALT NAVİGASYON -->
<!-- ===================================== -->
<nav class="mobile-bottom-nav d-md-none">

    @if (!Model.IsAdmin)
    {
        <a asp-controller="Message" asp-action="Index"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            <i class="bi bi-inbox"></i>
            <span>Gelen Kutusu</span>
        </a>

        <a asp-controller="Message" asp-action="SentMail"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "SentMail" ? "active" : "")">
            <i class="bi bi-send"></i>
            <span>Gönderilenler</span>
        </a>

        <a asp-controller="Message" asp-action="Important"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Important" ? "active" : "")">
            <i class="bi bi-star"></i>
            <span>Önemli</span>
        </a>

        <a asp-controller="Message" asp-action="Trash"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Trash" ? "active" : "")">
            <i class="bi bi-trash"></i>
            <span>Çöp</span>
        </a>
    }
    else
    {
        <a asp-controller="Admin" asp-action="Dashboard"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i>
            <span>Genel Bakış</span>
        </a>

        <a asp-controller="User" asp-action="Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
            <i class="bi bi-people"></i>
            <span>Kullanıcılar</span>
        </a>

        <a asp-controller="Admin" asp-action="MessageStatistics"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MessageStatistics" ? "active" : "")">
            <i class="bi bi-bar-chart"></i>
            <span>İstatistik</span>
        </a>

        <a asp-controller="Admin" asp-action="Complaints"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Complaints" ? "active" : "")">
            <i class="bi bi-flag"></i>
            <span>Şikayetler</span>
        </a>
    }

</nav>

<style>
    .user-avatar-img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--outline-variant);
        flex-shrink: 0;
    }

    .user-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
</style>