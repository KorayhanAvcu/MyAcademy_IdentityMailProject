<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Identity Mail</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/mail.css" asp-append-version="true" />
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site Css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet">
    <style>

        :root {
            --primary: #0041a2;
            --on-primary: #ffffff;
            --primary-container: #dae2ff;
            --on-primary-container: #001847;
            --secondary: #3f6377;
            --secondary-container: #c0e5fd;
            --on-secondary-container: #264b5e;
            --surface: #f7f9fd;
            --surface-container-lowest: #ffffff;
            --surface-container-low: #f2f4f8;
            --surface-container: #eceef2;
            --surface-container-high: #e6e8ec;
            --outline: #737785;
            --outline-variant: #c3c6d6;
            --on-surface: #181c1f;
            --on-surface-variant: #424654;
            --error: #ba1a1a;
            --error-container: #ffdad6;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            padding: 0;
            background: var(--surface);
            font-family: 'Inter', "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
            color: var(--on-surface);
        }

        a {
            text-decoration: none;
        }

        /*
                =============================
                Sidebar
                =============================
                */

        .mail-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 270px;
            height: 100vh;
            background: var(--surface-container-low);
            border-right: 1px solid var(--outline-variant);
            z-index: 1040;
            display: flex;
            flex-direction: column;
        }

        .mail-sidebar-header {
            padding: 26px 20px 20px;
        }

        .logo-circle {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: var(--primary);
            color: var(--on-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .mail-sidebar-header h4 {
            font-weight: 700;
            font-size: 16px;
            color: var(--primary);
        }

        .mail-sidebar .list-group {
            padding: 8px 12px;
            flex: 1;
            overflow-y: auto;
        }

        .mail-sidebar .list-group-item {
            border: none;
            border-radius: 999px;
            margin-bottom: 4px;
            padding: 11px 18px;
            display: flex;
            align-items: center;
            font-weight: 500;
            font-size: 14px;
            color: var(--on-surface-variant);
            background: transparent;
            transition: .2s;
        }

            .mail-sidebar .list-group-item:hover {
                background: var(--surface-container-high);
                color: var(--on-surface);
            }

            .mail-sidebar .list-group-item.active {
                background: var(--secondary-container);
                color: var(--on-secondary-container);
                font-weight: 600;
            }

        .sidebar-user {
            border-color: var(--outline-variant) !important;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 999px;
            background: var(--primary);
            color: var(--on-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /*
                =============================
                Top Navbar
                =============================
                */

        .mail-navbar {
            position: fixed;
            left: 270px;
            top: 0;
            right: 0;
            height: 72px;
            background: rgba(247, 249, 253, .9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--outline-variant);
            display: flex;
            align-items: center;
            z-index: 1030;
            padding: 0 30px;
        }

            .mail-navbar .input-group {
                border-radius: 999px;
                overflow: hidden;
                background: var(--surface-container);
                border: 1px solid transparent;
            }

                .mail-navbar .input-group:focus-within {
                    border-color: var(--primary);
                    background: var(--surface-container-lowest);
                }

            .mail-navbar .input-group-text,
            .mail-navbar .form-control {
                background: transparent;
                border: none;
                box-shadow: none;
            }

        /*
                =============================
                Page Content
                =============================
                */

        .mail-content {
            margin-left: 270px;
            margin-top: 72px;
            min-height: calc(100vh - 72px);
            padding: 30px;
        }

        /*
                =============================
                Cards / Buttons / Tables
                =============================
                */

        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 3px 15px rgba(0,0,0,.05);
            background: var(--surface-container-lowest);
        }

        .btn {
            border-radius: 999px;
            font-weight: 500;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
        }

            .btn-primary:hover {
                background: var(--on-primary-container);
                border-color: var(--on-primary-container);
            }

        .btn-outline-danger {
            border-radius: 999px;
        }

        .btn-icon {
            border: none;
            background: transparent;
            border-radius: 999px;
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--on-surface-variant);
            transition: .2s;
        }

            .btn-icon:hover {
                background: var(--surface-container-high);
                color: var(--on-surface);
            }

        .table {
            margin-bottom: 0;
        }

            .table thead {
                background: var(--surface-container-low);
            }

            .table th {
                border-bottom: none;
                font-weight: 600;
                color: var(--on-surface-variant);
            }

            .table tbody tr:hover {
                background: var(--surface-container-low);
            }

        /*
                =============================
                Mobile Bottom Nav
                =============================
                */

        .mobile-bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 64px;
            background: rgba(247, 249, 253, .95);
            backdrop-filter: blur(12px);
            border-top: 1px solid var(--outline-variant);
            z-index: 1050;
            display: none;
            align-items: center;
            justify-content: space-around;
        }

            .mobile-bottom-nav a {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 2px;
                color: var(--on-surface-variant);
                font-size: 11px;
                padding: 6px 14px;
                border-radius: 999px;
            }

                .mobile-bottom-nav a.active {
                    background: var(--secondary-container);
                    color: var(--on-secondary-container);
                }

        /*
                =============================
                Scroll / Responsive
                =============================
                */

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--outline-variant);
            border-radius: 20px;
        }

        @@media(max-width:992px) {
            .mail-sidebar {
                width: 230px;
            }

            .mail-navbar {
                left: 230px;
            }

            .mail-content {
                margin-left: 230px;
            }
        }

        @@media(max-width:767.98px) {
            .mail-sidebar {
                display: none;
            }

            .mail-navbar {
                left: 0;
            }

            .mail-content {
                margin-left: 0;
                padding: 16px;
            }

            .mobile-bottom-nav {
                display: flex;
            }
        }

    </style>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</head>