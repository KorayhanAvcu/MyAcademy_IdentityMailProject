@model List<Category>
@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Kategori Listesi</h2>
    </div>

    <div class="d-flex align-items-center gap-3">
        <a href="/Category/AddCategory"
           class="btn btn-primary d-none d-md-inline-flex align-items-center">

            <i class="bi bi-pencil-square me-2"></i>
            Yeni Kategori Ekle

        </a>


        <a href="/Message/SendMail"
           class="btn btn-primary d-md-none rounded-circle p-0 d-flex align-items-center justify-content-center"
           style="width:44px;height:44px;">

            <i class="bi bi-pencil-square"></i>

        </a>

    </div>

</div>
<div class="mail-list-card p-3">

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table mail-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>
                            Kategori
                        </th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>
                            <td>
                                @item.CategoryName

                            </td>

                            <td class="text-start">

                                <a href="/Category/UpdateCategory/@item.Id"
                                   class="btn btn-icon"
                                   title="Düzenle">

                                    <i class="bi bi-pencil"></i>

                                </a>


                                <button onclick="deleteCategory(@item.Id)"
                                        class="btn btn-icon text-danger border-0 bg-transparent">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-envelope fs-1 text-secondary"></i>

            <h4 class="mt-3">
                Kategori listesi boş
            </h4>

            <p class="text-muted">
                Henüz kategori girilmemiş.
            </p>

        </div>
    }

</div>



<script>

    
    function deleteCategory(id) {
         console.log(id);
        Swal.fire({
            title: "Uyarı",
            text: "Kategori Silinecek. Onaylıyor musunuz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet",
            cancelButtonText: "İptal"
        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href = "/Category/DeleteCategory/" + id;

            }

        });

    }
</script>

